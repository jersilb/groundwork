{
  "name": "groundwork",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-facilitated strategic planning for faith-based organizations.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "dev:web": "vite web",
    "build:web": "NODE_ENV=production vite build web",
    "postbuild:web": "node scripts/generate-cache-manifest.mjs",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply groundwork --local",
    "lint:vocab": "node scripts/lint-vocabulary.mjs",
    "lint:vocab:selftest": "node scripts/lint-vocabulary.mjs --self-test",
    "specs:compile": "node --experimental-strip-types scripts/compile-segment-specs.ts",
    "test:demo-pack": "node --experimental-strip-types scripts/test-demo-pack.ts",
    "test:session-plan": "node --experimental-strip-types scripts/test-session-plan.ts",
    "test:session-runtime": "node --experimental-strip-types scripts/test-session-runtime.ts",
    "test:six-hour-simulation": "node --experimental-strip-types scripts/test-six-hour-simulation.ts",
    "test:phase1": "node scripts/test-phase1-multiclient.mjs",
    "test:eval-harness": "node --experimental-strip-types scripts/run-eval-harness.ts",
    "test:pacer": "node --experimental-strip-types scripts/test-pacer.ts",
    "test:guide-runtime": "node --experimental-strip-types scripts/test-guide-runtime.ts",
    "test:evaluator-prober-parsing": "node --experimental-strip-types scripts/test-evaluator-prober-parsing.ts",
    "test:phase3": "node scripts/test-phase3-resilience.mjs",
    "test:phase4": "node scripts/test-phase4-audio.mjs",
    "test:synthesizer-provenance": "node --experimental-strip-types scripts/test-synthesizer-provenance.ts",
    "test:prompt-budgets": "node --experimental-strip-types scripts/test-prompt-budgets.ts",
    "test:guide-failure-paths": "node --experimental-strip-types scripts/test-guide-failure-paths.ts",
    "test:llm-timeout": "node --experimental-strip-types scripts/test-llm-timeout.ts",
    "test:coach-throttle": "node --experimental-strip-types scripts/test-coach-throttle.ts",
    "test:phase5": "node scripts/test-phase5-synthesis.mjs",
    "test:phase6": "node scripts/test-phase6-program.mjs",
    "test:session-integration": "node scripts/test-session-integration.mjs",
    "test:spine-integration": "node scripts/test-spine-integration.mjs",
    "test:stripe-webhook": "node --experimental-strip-types scripts/test-stripe-webhook-verification.ts",
    "test:phase7": "node scripts/test-phase7-pwa.mjs",
    "test:phase7-commerce-live": "node scripts/test-phase7-commerce-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.123.0",
    "yaml": "2.7.1"
  }
}
